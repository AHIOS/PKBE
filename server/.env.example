# Example environment for Render / tunnel / local HTTPS demos.
# Copy to a private .env (do not commit secrets) or paste into Render dashboard.
#
# Minimum for a physical-device demo:
#   PKBE_PUBLIC_BASE_URL=https://YOUR_HOST
#   PKBE_APPLE_TEAM_ID=ABCDE12345
#
# RP ID becomes YOUR_HOST; origins include https://YOUR_HOST.

PORT=8080

# Public HTTPS URL after TLS termination (Render or mole/localtunnel/ngrok/cloudflared).
PKBE_PUBLIC_BASE_URL=https://pkbe-example.onrender.com

# Optional overrides (leave empty to derive from PUBLIC_BASE_URL):
# PKBE_RP_ID=pkbe-example.onrender.com
# PKBE_ORIGINS=https://pkbe-example.onrender.com

PKBE_RP_NAME=PKBE
PKBE_APPLE_TEAM_ID=TEAMID
PKBE_IOS_BUNDLE_ID=com.uci.pkbe

# Optional: full AASA apps list instead of TEAMID + bundle
# PKBE_AASA_APPS=TEAMID.com.uci.pkbe

# Android Digital Asset Links (required for Credential Manager / WebView passkeys)
# PKBE_ANDROID_PACKAGE_NAME=com.uci.pkbe
# PKBE_ANDROID_SHA256_FINGERPRINTS=AA:BB:CC:...
# Debug fingerprint: cd android && ./gradlew signingReport

PKBE_REQUIRE_DEVICE_BOUND=false
PKBE_CHALLENGE_TTL_SECONDS=120
